VITE_SUPABASE_URL=https://pqvszoninxlnryrjvufh.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Google Calendar integration (optional)
# Create an OAuth 2.0 Web Client ID at https://console.cloud.google.com/
# Enable the Google Calendar API, then add your app origin to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Web Push (Declarative) — public VAPID key only (safe to expose in the client).
# Generate a pair with: npx web-push generate-vapid-keys
# Put the matching private key in Supabase Edge Function secrets (never in the client).
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
